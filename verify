#!/usr/bin/env bash

set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
solution="$repository_root/Staffetta.Core.slnx"

dotnet restore "$solution"
dotnet build "$solution" --configuration Release --no-restore
dotnet test "$solution" --configuration Release --no-build --no-restore \
  --filter "TestCategory!=AllocationEvidence" \
  --blame-hang --blame-hang-timeout 30s --blame-hang-dump-type mini
dotnet test "$repository_root/tests/Staffetta.Core.Tests/Staffetta.Core.Tests.csproj" \
  --configuration Release --no-build --no-restore \
  --filter "TestCategory=AllocationEvidence"
